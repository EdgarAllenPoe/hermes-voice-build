{
  "bind": "127.0.0.1",
  "port": 8765,
  "state_directory": "~/.local/state/hermes-voice",
  "token_file": "~/.config/hermes-voice/token",
  "quota_bytes": 104857600,
  "whisper_executable": "/REPLACE/WITH/whisper.cpp/build/bin/whisper-cli",
