  "language": "auto",
  "hermes_executable": "/REPLACE/WITH/absolute/path/to/hermes",
  "hermes_working_directory": "~",
  "delivery_mode": "review",
  "transcribe_timeout": 7200,
  "hermes_timeout": 7200
}
